# =============================================================
# TRINETRA AI — Environment Variables
# Copy this file to `.env` and fill in real values.
# NEVER commit your actual `.env` file.
# =============================================================

# development | production | testing
FLASK_ENV=development

# REQUIRED in production — also used to sign login sessions (Flask-Login)
# and CSRF tokens (Flask-WTF). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app logs a warning on startup if this is still the default value
# while FLASK_ENV=production.
SECRET_KEY=dev-insecure-key-change-me

# Defaults to a local SQLite file under database/trinetra.db if unset.
# For Postgres/MySQL in production:
#   DATABASE_URL=postgresql://user:pass@host:5432/trinetra
DATABASE_URL=

# Secure Chat server-to-server integration. Keep the API key only in the
# backend environment of each application; never expose it to browser code.
SECURE_CHAT_API_KEY=
# Exact deployed Secure Chat browser origin, including scheme and optional port.
# This controls which origin is allowed to make cross-origin (CORS) requests.
# For the production Secure Chat deployment:
SECURE_CHAT_ORIGIN=https://secure-chat-two-green.vercel.app
# Exact callback URL in Secure Chat that receives one-time authorization codes.
SECURE_CHAT_REDIRECT_URI=https://secure-chat-two-green.vercel.app/integrations/trinetra/callback
SECURE_CHAT_CODE_TTL_SECONDS=300
SECURE_CHAT_TOKEN_TTL_SECONDS=3600

# Max upload size in megabytes (screenshots / audio uploads)
MAX_UPLOAD_MB=10

# Port for local dev server (deployment platforms usually set this themselves)
PORT=5000

# Whisper checkpoint size for Voice Scam Detection: tiny/base/small/medium/large
WHISPER_MODEL_SIZE=tiny

# Hard deadline (seconds) for Whisper transcription in the background thread.
# Set slightly below Render's 30-second proxy timeout so Flask can still send a
# clean JSON error before the platform proxy cuts the connection.
# Increase this if you use a larger Whisper model (e.g. "small" → 180).
WHISPER_TIMEOUT_SECONDS=85

# Only needed if the tesseract binary isn't already on PATH (common on Windows)
TESSERACT_CMD=

# Optional: seed Phase-1 demo ScanHistory rows when the table is empty (0/1).
# Leave unset/0 so the dashboard shows only real user scans.
SEED_DEMO=0
